# Copia este archivo como .env y rellena los valores. No subas .env a GitHub.
DATA_PATH=data/

# Ruta al repo de Deloitte clonado (dataset de Tarvia)
TARVIA_PATH=data/tarvia

# API simulada del SOC (src/soc_client.py)
# Usad 127.0.0.1, no «localhost»: en Windows, «localhost» añade ~2 s a CADA consulta.
SOC_API_URL=http://127.0.0.1:8000
SOC_API_TIMEOUT=120

# LLM: modelo «ornith» en las GPU del DCC (src/llm.py). API compatible con OpenAI.
# La clave es DEL EQUIPO: pégala aquí y no la compartas fuera ni la subas a git.
LLM_BASE_URL=https://dcc-llm-gw.uab.cat/uabthehack/v1
LLM_API_KEY=
LLM_MODEL=ornith
# Máximo de tokens de respuesta (incluye el razonamiento). No lo bajéis: si se agota,
# la respuesta sale vacía. El máximo de ornith es 32768.
LLM_MAX_TOKENS=32000
# ¿Razona el modelo antes de responder? false (por defecto) ≈ 11 s por alerta;
# true ≈ 100 s por alerta, con veredictos casi iguales en nuestras pruebas.
LLM_THINKING=false
# Segundos máximos por petición
LLM_TIMEOUT=300
