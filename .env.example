# Copia este archivo como .env y rellena los valores. No subas .env a GitHub.
DATA_PATH=data/

# Ruta al repo de Deloitte clonado (dataset de Tarvia)
TARVIA_PATH=data/tarvia

# Claude (src/llm.py). La clave se crea en console.anthropic.com.
ANTHROPIC_API_KEY=
# Modelo y esfuerzo (low | medium | high | xhigh | max). Opcionales.
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
