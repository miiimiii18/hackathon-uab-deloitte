# Copia este archivo como .env y rellena los valores. No subas .env a GitHub.
DATA_PATH=data/

# Ruta al repo de Deloitte clonado (dataset de Tarvia)
TARVIA_PATH=data/tarvia

# API simulada del SOC (src/soc_client.py)
# Usad 127.0.0.1, no «localhost»: en Windows, «localhost» añade ~2 s a CADA consulta.
SOC_API_URL=http://127.0.0.1:8000
SOC_API_TIMEOUT=120

# LLM local con Ollama (src/llm.py). Gratis: no hace falta clave.
# Si Ollama corre en otro portátil de la misma red, poned su IP en vez de 127.0.0.1.
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=gpt-oss:20b
# Contexto en tokens (más = más memoria de la gráfica)
LLM_NUM_CTX=16384
# Cuánto piensa el modelo. gpt-oss: low | medium | high. Vacío = valor del modelo.
LLM_THINK=
# Segundos máximos por alerta
LLM_TIMEOUT=600
